[
  {
    "id": "single-shipped-unit",
    "title": "One unit shipped, customer says it looks wrong",
    "procedure": "damaged-or-wrong-item",
    "lesson": "When one unit shipped, ask for a photo of that unit only. Do not ask which item or for photos of everything.",
    "case": {
      "account": "Fixture Parts support <help@fixture-parts.test>",
      "customer_email": "customer@fixture-mail.test",
      "order": {
        "number": "F-1001",
        "items": [
          {
            "sku": "FX-VALVE-1",
            "name": "Fixture water valve",
            "quantity_shipped": 1
          }
        ]
      },
      "messages": [
        {
          "from": "customer",
          "at": "2026-09-20T14:00:00Z",
          "text": "The part I got does not look like the one in the listing.",
          "attachments": []
        }
      ],
      "human_direction": "none",
      "standing_authority": [
        "product_label_photo"
      ],
      "notes": []
    },
    "expect": {
      "action": "send_message",
      "must_request": [
        "product_label_photo"
      ],
      "must_not_request": [
        "order_number",
        "installation_photo",
        "model_number"
      ],
      "max_requests": 1,
      "subject_skus": [
        "FX-VALVE-1"
      ]
    }
  },
