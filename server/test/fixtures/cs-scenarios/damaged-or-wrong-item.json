  {
    "id": "photo-already-provided",
    "title": "Label photo already attached",
    "procedure": "damaged-or-wrong-item",
    "lesson": "Read the attachments first. A remedy is a business decision, so raise one question and ask the customer for nothing.",
    "case": {
      "account": "Fixture Parts support <help@fixture-parts.test>",
      "customer_email": "customer@fixture-mail.test",
      "order": {
        "number": "F-1001",
        "items": [
          {
            "sku": "FX-VALVE-1",
            "name": "Fixture water valve",
            "quantity_shipped": 1
          }
        ]
      },
      "messages": [
        {
          "from": "customer",
          "at": "2026-09-20T14:00:00Z",
          "text": "Wrong part received. Label photo attached. Please send the right one.",
          "attachments": [
            "label.jpg: legible product label"
          ]
        }
      ],
      "human_direction": "none",
      "standing_authority": [
        "product_label_photo"
      ],
      "notes": []
    },
    "expect": {
      "action": "raise_decision",
      "must_not_request": [
        "product_label_photo",
        "damage_photo",
        "order_number"
      ],
      "max_requests": 0
    }
  },
