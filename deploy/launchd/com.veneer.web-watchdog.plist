<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.veneer.web-watchdog</string>
  <key>ProgramArguments</key><array>
    <string>__NODE__</string><string>__CODE_DIR__/server/dist/ops/webWatchdogMain.js</string>
    <string>--data-dir</string><string>__DATA_DIR__</string><string>--port</string><string>__WEB_PORT__</string>
  </array>
  <key>WorkingDirectory</key><string>__CODE_DIR__</string>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__LOG_DIR__/veneer-web-watchdog.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/veneer-web-watchdog.log</string>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>__HOME__</string><key>PATH</key><string>__PATH__</string></dict>
</dict></plist>
